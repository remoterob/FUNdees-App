SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
STRIPE_SECRET_KEY=sk_live_...
STRIPE_ANNUAL_PRICE_ID=price_...
STRIPE_STUDENT_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
URL=https://YOUR-SITE-NAME.netlify.app

# Daily backup email (netlify/functions/daily-backup.js)
RESEND_API_KEY=re_...                 # Resend API key; sending domain must be verified
BACKUP_SECRET=long-random-string      # guards manual HTTP triggering of the backup

# Auth emails (password reset, etc.) are sent by SUPABASE, not by these functions.
# Configure Resend as Supabase's custom SMTP provider in the Supabase dashboard:
#   Host smtp.resend.com · Port 465 · User "resend" · Pass = your RESEND_API_KEY
# See SETUP.md "STEP 10". The SMTP password lives in Supabase, not in this file.
